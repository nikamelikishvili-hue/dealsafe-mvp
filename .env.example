# Required in Local, Preview, Staging, and Production.
# Use the project origin only, for example https://project-ref.supabase.co.
VITE_SUPABASE_URL=
# Browser-safe publishable/anon key only. Never use sb_secret_ or service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Required server-side for /api/auth in Preview, Staging, and Production.
# These are the same public project URL and publishable key, never privileged credentials.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional. Address entry remains available as structured manual fields without it.
VITE_GOOGLE_MAPS_API_KEY=
