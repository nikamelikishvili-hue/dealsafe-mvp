# Optional locally and inferred from Vercel elsewhere. Set the exact value
# `staging` only when a protected Vercel Preview is acting as Staging.
# DEALIVRA_RUNTIME_ENVIRONMENT=staging

# Required in Preview, Staging, and Production, and for real Auth in Local.
# A Local static/demo build may omit the Supabase browser/server variables.
# Use the project origin only, for example https://project-ref.supabase.co.
VITE_SUPABASE_URL=
# Browser-safe publishable/anon key only. Never use sb_secret_ or service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Required server-side for /api/auth in Preview, Staging, and Production.
# These are the same public project URL and publishable key, never privileged credentials.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Disabled by default. Enable only after Supabase Auth IP forwarding is
# explicitly enabled and the server-only secret key is stored in Vercel.
DEALIVRA_AUTH_IP_FORWARDING_MODE=disabled
# Server-only sb_secret_ key used exclusively as the Auth proxy apikey when
# forwarding the Vercel-verified client IP. Never use a VITE_ prefix.
SUPABASE_AUTH_SECRET_KEY=

# Keep staged until the matching Supabase project has "require current
# password" enabled and the controlled Preview matrix has passed.
DEALIVRA_CURRENT_PASSWORD_MODE=staged

# Staged by default. Set to enforced in both Vercel and Supabase Edge only
# after the reviewed recovery migration and rollback proof pass.
DEALIVRA_RECOVERY_CONTROL_MODE=staged

# Supabase Edge security-notification delivery remains staged until the sender
# domain, worker invocation, retry alert, and provider have been approved.
DEALIVRA_SECURITY_NOTIFICATION_MODE=staged

# Every Stripe provider mutation is disabled by default. `sandbox` permits only
# the named capability and still requires a test-mode Stripe secret/account.
DEALIVRA_SELLER_ONBOARDING_MODE=disabled
DEALIVRA_CHECKOUT_MODE=disabled
DEALIVRA_PAYOUT_RELEASE_MODE=disabled
DEALIVRA_REFUND_MODE=disabled

# Default-off privacy-safe Web Vitals intake. Enforce only after the reviewed
# retention, alert, Firewall, protected synthetic, and rollback gates pass.
DEALIVRA_WEB_VITAL_MODE=staged

# Default-off privacy-safe rejection and client-failure intakes. Enforce only
# after the reviewed retention, alert, Firewall, synthetic, and rollback gates.
DEALIVRA_RUNTIME_REJECTION_MODE=staged
DEALIVRA_CLIENT_FAILURE_MODE=staged

# Server/CI-only values for read-only checks against an access-protected
# Preview. Never use a VITE_ prefix and never place the bypass value in a URL.
DEALIVRA_SYNTHETIC_BASE_URL=
DEALIVRA_SYNTHETIC_BYPASS_SECRET=
# Production is denied unless the exact value below is set for an approved
# read-only run. It never permits sign-in, mutation, payment, or test data.
DEALIVRA_SYNTHETIC_PRODUCTION_MODE=disabled

# Optional. Address entry remains available as structured manual fields without it.
VITE_GOOGLE_MAPS_API_KEY=
