    "requiredReview": [
      "source and ownership review",
      "privacy and public-field review",
      "keyboard and manual-fallback review",
      "Preview deployment verification"
    ]
  },
  "metrics": {
    "source": "public.get_admin_catalog_adoption(integer)",
    "windowsDays": [7, 30, 90],
    "dimensions": [
