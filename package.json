{
  "name": "dealivra-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "format": "biome format --write biome.json package.json package-lock.json scripts/run-component-tests.mjs tests/components",
    "format:check": "biome format biome.json package.json package-lock.json scripts/run-component-tests.mjs tests/components",
    "lint": "biome lint src api server scripts tests vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run test:foundation && npm run test:components",
    "test:foundation": "node --test --test-isolation=none tests/foundation.test.mjs",
    "test:components": "node scripts/run-component-tests.mjs",
    "catalog:verify": "node scripts/validate-catalog-release.mjs",
    "dependency:policy": "node scripts/verify-dependency-policy.mjs",
    "security:browser-storage": "node scripts/verify-browser-storage-policy.mjs",
    "security:transport": "node scripts/verify-outbound-transport-policy.mjs",
    "security:mutation-origins": "node scripts/verify-api-mutation-origin-policy.mjs",
    "security:abuse-policy": "node scripts/verify-api-abuse-control-policy.mjs",
    "brand:verify": "node scripts/verify-legacy-identifiers.mjs",
    "config:verify": "node scripts/verify-runtime-configuration.mjs --contract",
    "config:check": "node scripts/verify-runtime-configuration.mjs",
    "staging:database-target": "node scripts/verify-staging-database-target.mjs",
    "database:baseline:status": "node scripts/verify-database-baseline.mjs --allow-missing",
    "database:baseline:verify": "node scripts/verify-database-baseline.mjs",
    "security:secrets": "node scripts/scan-repository-secrets.mjs",
    "security:mfa-matrix": "node scripts/run-mfa-password-only-matrix.mjs",
    "staging:http-authorization": "node scripts/run-staging-http-authorization-matrix.mjs",
    "database:ownership:validate": "node scripts/validate-database-ownership-inventory.mjs",
    "performance:budgets": "node scripts/verify-build-budgets.mjs",
    "build": "npm run config:check && tsc -b && vite build --configLoader native && npm run release:served-manifest && npm run performance:budgets",
    "preview": "vite preview --configLoader native",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "smoke:protected": "node scripts/run-protected-synthetic.mjs",
    "incident:drill": "node scripts/run-incident-control-drill.mjs",
    "release:sbom": "node scripts/create-dependency-sbom.mjs",
    "release:served-manifest": "node scripts/create-served-asset-manifest.mjs",
    "release:served-verify": "node scripts/verify-served-assets.mjs",
    "release:evidence": "node scripts/create-release-evidence.mjs",
    "verify": "npm run catalog:verify && npm run dependency:policy && npm run release:sbom && npm run security:browser-storage && npm run security:transport && npm run security:mutation-origins && npm run security:abuse-policy && npm run brand:verify && npm run config:verify && npm run format:check && npm run lint && npm run typecheck && npm test && npm run incident:drill && npm run security:secrets && npm run build && npm run smoke:preview"
  },
  "dependencies": {
    "lucide-react": "1.32.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  },
  "engines": {
    "node": "24.x"
  }
}
