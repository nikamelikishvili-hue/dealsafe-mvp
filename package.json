{
  "name": "dealivra-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test --test-isolation=none tests/foundation.test.mjs",
    "catalog:verify": "node scripts/validate-catalog-release.mjs",
    "security:secrets": "node scripts/scan-repository-secrets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "verify": "npm run catalog:verify && npm run typecheck && npm test && npm run security:secrets && npm run build && npm run smoke:preview"
  },
  "dependencies": {
    "lucide-react": "1.25.0",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=24"
  }
}
